#!/usr/bin/env bash
# Rerunnable behavior baseline for the vendored Superpowers plugin.
# Usage: run-behavior [--case <name>|all] [--runs N] [--model ID] [--arms FILE] [--record-dir DIR] [--yes]
#        run-behavior --suite [--case NAME] [--runs N] [--ab-model ID] [--record-dir DIR] [--yes]
# Exit: 0 all criteria met, 1 a criterion failed, 2 usage error or partial eval, 3 preflight failed.
set -uo pipefail

HERE=$(cd -P "$(dirname "$0")" && pwd)
REPO=$(cd -P "$HERE/../.." && pwd)
EVALS="$HERE/evals"
CONF="$EVALS/arms.conf"
RECORD_DIR="${WARDEN_BEHAVIOR_RECORD_DIR:-}"
RAW_BASE="${WARDEN_BEHAVIOR_RAW_DIR:-$HOME/.cache/warden-behavior}"
LABEL="list-price estimate; not billed on a subscription login, uses your plan's usage limits"

SETUP_STUB_CASES="read-order read-order-heldout"
CASE=all RUNS=5 MODEL="" YES=0 SUITE=0 ABMODEL=""
usage() { echo "usage: run-behavior [--case <name>|all] [--runs N] [--model ID] [--arms FILE] [--record-dir DIR] [--yes]
       run-behavior --suite [--case NAME] [--runs N] [--ab-model ID] [--record-dir DIR] [--yes]" >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    --case) [ $# -ge 2 ] || usage; CASE="$2"; shift ;;
    --runs) [ $# -ge 2 ] || usage; RUNS="$2"; shift ;;
    --model) [ $# -ge 2 ] || usage; MODEL="$2"; shift ;;
    --arms) [ $# -ge 2 ] || usage; CONF="$2"; shift ;;
    --record-dir) [ $# -ge 2 ] || usage; RECORD_DIR="$2"; shift ;;
    --yes) YES=1 ;;
    --suite) SUITE=1 ;;
    --ab-model) [ $# -ge 2 ] || usage; ABMODEL="$2"; shift ;;
    *) usage ;;
  esac
  shift
done
case "$RUNS" in ''|*[!0-9]*|0) usage ;; esac
[ -z "$ABMODEL" ] || [ "$SUITE" -eq 1 ] || usage
[ "$SUITE" -eq 1 ] || [ -f "$CONF" ] || { echo "arms file not found: $CONF" >&2; exit 2; }
SUMMARY_ARGS=()
if [ "$SUITE" -eq 1 ]; then
  SUITE_CONF="$EVALS/suite.conf"
  SUMMARY_ARGS=(--summary)
  [ -n "$RECORD_DIR" ] || RECORD_DIR="${WARDEN_LESSON_ROOT:-$HOME/.claude/lessons}/suite"
  [ -z "$MODEL" ] || { echo "suite does not take --model; use --ab-model" >&2; exit 2; }
  # Suite checks come before the preflight, in this order.
  branch=$(git -C "$REPO" symbolic-ref --short -q HEAD 2>/dev/null) || branch=HEAD
  [ "$branch" = main ] || { echo "suite runs only on main (current: $branch)" >&2; exit 2; }
  dirty=$(git -C "$REPO" status --porcelain -- plugins tests/behavior | head -n1 | cut -c4-)
  [ -z "$dirty" ] || { echo "suite needs a clean checkout: $dirty" >&2; exit 2; }
  [ -f "$SUITE_CONF" ] || { echo "suite criteria not found: $SUITE_CONF" >&2; exit 2; }
  for d in "$EVALS"/*/; do
    name=$(basename "$d")
    [ "$name" = _fixture ] && continue
    awk -v n="$name" '$1 !~ /^#/ && $1 == n {f=1} END {exit !f}' "$SUITE_CONF" || { echo "no suite criterion for $name" >&2; exit 2; }
  done
  while read -r name _; do
    case "$name" in ''|'#'*) continue ;; esac
    [ -d "$EVALS/$name" ] && [ "$name" != _fixture ] || { echo "no eval directory for $name" >&2; exit 2; }
  done < "$SUITE_CONF"
  behind=$(git -C "$REPO" rev-list --count main..refs/remotes/fork/main 2>/dev/null) || behind=0
  [ "${behind:-0}" -le 0 ] || echo "warning: main is $behind commits behind fork/main (last fetch)"
else
  [ -n "$RECORD_DIR" ] || RECORD_DIR="$REPO/docs/superpowers/changes/2026-10-rerunnable-behavior-baseline/runs"
fi

CHECK=(python3 -I "$HERE/lib/merge_check.py")
MERGE_STUB=()
if [ -n "${WARDEN_BEHAVIOR_MERGE_CHECK:-}" ]; then
  echo "warning: WARDEN_BEHAVIOR_MERGE_CHECK is set; this run is a test run and grades nothing" >&2
  MERGE_STUB=(--merge-check-stub)
  CHECK=("$WARDEN_BEHAVIOR_MERGE_CHECK")
fi

die3() { echo "preflight failed: $*" >&2; exit 3; }

# Preflight, in order.
claude --version >/dev/null 2>&1 || die3 "'claude --version' does not work"
GRAPHIFY_VERSION=$(graphify --version 2>/dev/null | head -n1) || true
[ -n "$GRAPHIFY_VERSION" ] || die3 "'graphify --version' does not work"
[ -z "${ANTHROPIC_API_KEY:-}" ] || die3 "ANTHROPIC_API_KEY is set; unset it so the run uses your login"
[ -z "${ANTHROPIC_AUTH_TOKEN:-}" ] || die3 "ANTHROPIC_AUTH_TOKEN is set; unset it so the run uses your login"

# The trace cache must not sit inside a git work tree. Check its nearest existing ancestor.
guard_dir="$RAW_BASE"
while [ ! -d "$guard_dir" ] && [ "$guard_dir" != "/" ] && [ "$guard_dir" != "." ]; do guard_dir=$(dirname "$guard_dir"); done
if git -C "$guard_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "trace cache $RAW_BASE is inside a git work tree; set WARDEN_BEHAVIOR_RAW_DIR to a folder outside any repository" >&2
  exit 2
fi

resolve() { git -C "$REPO" rev-parse --verify -q "$1^{commit}" 2>/dev/null; }
FETCHED=0
resolve_or_fetch() {
  local sha
  sha=$(resolve "$1") && { printf '%s\n' "$sha"; return 0; }
  if [ "$FETCHED" -eq 0 ]; then FETCHED=1; git -C "$REPO" fetch -q fork >/dev/null 2>&1 || true; fi
  resolve "$1"
}

WORK=$(mktemp -d "${TMPDIR:-/tmp}/warden-behavior.XXXXXX") || exit 2
trap 'rm -rf "$WORK"' EXIT

if [ "$SUITE" -eq 1 ]; then
  # Suite mode writes its own arms file: one candidate-only row per case at HEAD, plus one pinned-model row with --ab-model.
  headsha=$(git -C "$REPO" rev-parse HEAD) || exit 2
  CONF="$WORK/suite-arms.conf"
  : > "$CONF"
  while read -r name rule count; do
    case "$name" in ''|'#'*) continue ;; esac
    printf '%s - %s %s %s\n' "$name" "$headsha" "$rule" "$count" >> "$CONF"
    [ -z "$ABMODEL" ] || printf '%s - %s %s %s %s\n' "$name" "$headsha" "$rule" "$count" "$ABMODEL" >> "$CONF"
  done < "$SUITE_CONF"
fi

# Resolve arms.conf into full SHAs, filtered by --case.
: > "$WORK/conf"
: > "$WORK/keys"
while read -r c base cand rule count amodel; do
  case "$c" in ''|'#'*) continue ;; esac
  # A baseline of "-" means candidate only: pass it through unresolved.
  if [ "$base" = "-" ]; then bsha="-"; else
    bsha=$(resolve_or_fetch "$base") || die3 "ref $base in $(basename "$CONF") does not resolve"
  fi
  csha=$(resolve_or_fetch "$cand") || die3 "ref $cand in $(basename "$CONF") does not resolve"
  if [ "$CASE" = all ] || [ "$CASE" = "$c" ]; then
    printf '%s %s %s %s %s%s\n' "$c" "$bsha" "$csha" "$rule" "$count" "${amodel:+ $amodel}" >> "$WORK/conf"
    # keys: case, baseline arm key, candidate arm key. An arm key is <sha> or <sha>@<model>.
    printf '%s %s %s\n' "$c" "$bsha" "$csha${amodel:+@$amodel}" >> "$WORK/keys"
  fi
done < "$CONF"
[ -s "$WORK/conf" ] || { echo "no case matches '$CASE'" >&2; exit 2; }

NCASES=$(awk '!seen[$1]++' "$WORK/conf" | wc -l | tr -d ' ')
NARMS=0 LO=0 HI=0
while read -r c base _ _ _; do
  arms=2; [ "$base" = "-" ] && arms=1
  NARMS=$((NARMS + arms))
  case "$c" in
    setup-planning|read-order*) LO=$((LO + 10 * arms * RUNS)); HI=$((HI + 40 * arms * RUNS)) ;;
    *) LO=$((LO + 2 * arms * RUNS)); HI=$((HI + 10 * arms * RUNS)) ;;
  esac
done < "$WORK/conf"
AGENTS=$((NARMS * RUNS))
fmt() { printf '%d.%02d' $(($1 / 100)) $(($1 % 100)); }

echo "Agents: $AGENTS ($NCASES cases, $NARMS arms x $RUNS runs)"
echo "Model: ${MODEL:-account default}"
echo "Estimate: US\$$(fmt $LO) to US\$$(fmt $HI) at US\$0.10-0.40 per planning run and US\$0.02-0.10 per other run ($LABEL)"
if [ "$YES" -ne 1 ]; then
  printf 'Start %s agents? [y/N] ' "$AGENTS"
  read -r ans || ans=n
  case "$ans" in y|Y|yes|YES) ;; *) echo "Cancelled."; exit 2 ;; esac
fi

# Materialize and evaluate each distinct arm (commit plus optional model) once.
REFS=$(awk '{print $2; print $3}' "$WORK/keys" | awk '$0 != "-" && !seen[$0]++')
ID=$(python3 -I -c 'import secrets;print(secrets.token_hex(3))')
RESULT_ARGS=()
n=0
SS_SEEN=" "
for key in $REFS; do
  n=$((n + 1))
  sha=${key%%@*}
  armmodel=""; armdir=$(printf '%s' "$sha" | cut -c1-7)
  case "$key" in *@*) armmodel=${key#*@}; armdir="$armdir-$armmodel" ;; esac
  scratch="$WORK/arm-$n"
  mkdir -p "$scratch"
  git -C "$REPO" archive "$sha" plugins/superpowers | tar -x -C "$scratch" || { echo "git archive failed for $sha" >&2; exit 2; }
  # plugin eval loads one plugin. When the arm has plugins/warden, merge the whole plugin, minus its two manifest files, into the scratch Superpowers plugin.
  if git -C "$REPO" cat-file -e "$sha:plugins/warden" 2>/dev/null; then
    wtmp="$WORK/warden-$n"
    mkdir -p "$wtmp"
    git -C "$REPO" archive "$sha" plugins/warden | tar -x -C "$wtmp" || { echo "git archive failed for $sha" >&2; exit 2; }
    wsrc="$wtmp/plugins/warden"
    sdst="$scratch/plugins/superpowers"
    # Only the two manifest files may sit in .claude-plugin/. Any other file there stops the run.
    if [ -d "$wsrc/.claude-plugin" ]; then
      while IFS= read -r f; do
        case "$f" in plugin.json|marketplace.json) ;; *) echo "unexpected warden manifest file: .claude-plugin/$f" >&2; exit 2 ;; esac
      done < <(cd "$wsrc/.claude-plugin" && find . -type f | sed 's|^\./||' | sort)
    fi
    while IFS= read -r f; do
      case "$f" in .claude-plugin/plugin.json|.claude-plugin/marketplace.json|hooks/hooks.json) continue ;; esac
      if [ -e "$sdst/$f" ]; then echo "merge collision: $f" >&2; exit 2; fi
      mkdir -p "$(dirname "$sdst/$f")"
      cp -p "$wsrc/$f" "$sdst/$f"
    done < <(cd "$wsrc" && find . -type f | sed 's|^\./||' | sort)
    if [ -f "$wsrc/hooks/hooks.json" ]; then
      mkdir -p "$sdst/hooks"
      python3 -I - "$sdst/hooks/hooks.json" "$wsrc/hooks/hooks.json" <<'PY' || { echo "error: could not merge warden hooks.json for $sha" >&2; exit 2; }
import json, sys
dst, src = sys.argv[1:3]
d = json.load(open(dst))
w = json.load(open(src))
for event, entries in w.get("hooks", {}).items():
    d.setdefault("hooks", {}).setdefault(event, []).extend(entries)
with open(dst, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
PY
    fi
    # The merge must leave every warden file in the scratch plugin. WARDEN_BEHAVIOR_MERGE_CHECK is a test seam.
    "${CHECK[@]}" "$wsrc" "$sdst" || exit 2
  fi
  dest="$scratch/plugins/superpowers/warden-evals"
  mkdir -p "$dest"
  cp -R "$EVALS/." "$dest/"
  rm -f "$dest/arms.conf" "$dest/suite.conf"
  res="$WORK/result-$n.json"
  model_args=()
  [ -n "$armmodel" ] && model_args=(--model "$armmodel")
  [ -z "$armmodel" ] && [ -n "$MODEL" ] && model_args=(--model "$MODEL")
  # plugin eval honours only the last --case, so run one eval per case and merge.
  parts=()
  k=0
  for c in $(awk -v s="$key" '$2==s || $3==s {print $1}' "$WORK/keys" | awk '!seen[$0]++'); do
    k=$((k + 1))
    part="$WORK/result-$n-$k.json"
    echo "Evaluating $(printf '%s' "$sha" | cut -c1-7) $c ..."
    run_dir="$scratch"
    case " $SETUP_STUB_CASES " in
      *" $c "*)
        if [ -e "$scratch/plugins/superpowers/scripts/graphify-setup" ]; then
          # The eval sandbox blocks git, so run on a copy whose graphify-setup is the stub. The scratch arm stays unchanged.
          run_dir="$WORK/arm-$n-$c"
          cp -R "$scratch" "$run_dir" || { echo "error: could not copy arm for $sha in $c" >&2; exit 2; }
          cp "$HERE/lib/setup-status-stub" "$run_dir/plugins/superpowers/scripts/graphify-setup" || { echo "error: could not place the setup status stub for $sha in $c" >&2; exit 2; }
          chmod 755 "$run_dir/plugins/superpowers/scripts/graphify-setup"
          case "$SS_SEEN" in *" $sha:$c "*) ;; *) SS_SEEN="$SS_SEEN$sha:$c "; RESULT_ARGS+=(--setup-status "$sha:$c=stubbed (ready)") ;; esac
        else
          case "$SS_SEEN" in *" $sha:$c "*) ;; *) SS_SEEN="$SS_SEEN$sha:$c "; RESULT_ARGS+=(--setup-status "$sha:$c=not present") ;; esac
        fi ;;
    esac
    ( cd "$run_dir" && claude plugin eval "$run_dir/plugins/superpowers" \
        --no-publish --ablation none --scaffold --trust-plugin --keep-temp \
        --eval-dir warden-evals --json "$part" --allow-tools Bash --runs "$RUNS" \
        ${model_args[@]+"${model_args[@]}"} --case "$c" >"$WORK/eval-$n-$k.log" 2>&1 )
    parts+=("$part")
  done
  python3 -I - "$res" "${parts[@]}" <<'PY' || { echo "error: could not merge eval results for $sha" >&2; exit 2; }
import json, sys
out, parts = sys.argv[1], sys.argv[2:]
merged = None
for p in parts:
    d = json.load(open(p))
    if merged is None:
        merged = d
        continue
    merged["cases"] += d.get("cases", [])
    merged["costUsd"] = (merged.get("costUsd") or 0) + (d.get("costUsd") or 0)
    merged["partial"] = bool(merged.get("partial")) or bool(d.get("partial"))
json.dump(merged, open(out, "w"))
PY
  # record.py deletes the eval temp folders, so copy each trace into the trace cache first.
  python3 -I - "$res" "$RAW_BASE/$ID/traces" "$armdir" <<'PY' || { echo "error: could not copy traces for $sha" >&2; exit 2; }
import json, os, shutil, sys
res, dest, arm = sys.argv[1:4]
for c in json.load(open(res)).get("cases", []):
    for i, r in enumerate((c.get("arms") or {}).get("with") or [], 1):
        tp = r.get("tracePath")
        if tp and os.path.isfile(tp):
            d = os.path.join(dest, c["name"], arm)
            os.makedirs(d, exist_ok=True)
            shutil.copyfile(tp, os.path.join(d, "run-%d.jsonl" % i))
PY
  RESULT_ARGS+=(--result "$key=$res")
done

FIXTURE_HASH=$(git -C "$REPO" rev-parse HEAD:tests/behavior/evals/_fixture/storefront)
python3 -I "$HERE/lib/record.py" --conf "$WORK/conf" --out-dir "$RECORD_DIR" --runs "$RUNS" \
  --graphify-version "$GRAPHIFY_VERSION" --fixture-hash "$FIXTURE_HASH" --id "$ID" \
  --raw-dir "$RAW_BASE/$ID" ${SUMMARY_ARGS[@]+"${SUMMARY_ARGS[@]}"} ${MERGE_STUB[@]+"${MERGE_STUB[@]}"} "${RESULT_ARGS[@]}"
rc=$?

# Suite mode: compare with the newest earlier record that has different pins. A failure here keeps the recorder's code.
if [ "$SUITE" -eq 1 ] && [ "$rc" -le 1 ]; then
  python3 -I "$HERE/lib/suite_compare.py" --folder "$RECORD_DIR" --new "$ID" --repo "$REPO" \
    || echo "warning: the suite comparison failed" >&2
fi

# Keep the raw results outside the repo.
if [ "$rc" -le 1 ]; then
  mkdir -p "$RAW_BASE/$ID" && cp "$WORK"/result-[0-9].json "$WORK"/result-[0-9][0-9].json "$RAW_BASE/$ID/" 2>/dev/null || true
fi
# Retention runs whatever record.py returned: keep the newest 20 run folders. Only six-hex-character folders are touched.
python3 -I - "$RAW_BASE" <<'PY'
import os, re, shutil, sys
base = sys.argv[1]
runs = [e for e in os.scandir(base) if re.fullmatch(r"[0-9a-f]{6}", e.name) and e.is_dir(follow_symlinks=False)]
runs.sort(key=lambda e: e.stat(follow_symlinks=False).st_mtime)
for e in runs[:-20]:
    shutil.rmtree(e.path, ignore_errors=True)
PY
exit "$rc"
