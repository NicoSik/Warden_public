#!/usr/bin/env bash
# Offline stub for claude. Handles --version and `plugin eval`; records argv.
# Refuses (exit 99) unless called through the path the test expects.
if [ "$0" != "${WARDEN_STUB_EXPECT_CLAUDE:-}" ]; then
  echo "claude stub: called as '$0', expected '${WARDEN_STUB_EXPECT_CLAUDE:-unset}'" >&2
  exit 99
fi
LOG="${WARDEN_STUB_LOG:?}"
if [ "${1:-}" = "--version" ]; then
  echo "CALL version" >> "$LOG"
  echo "2.1.305 (Claude Code)"
  exit 0
fi
if [ "${1:-}" = "plugin" ] && [ "${2:-}" = "eval" ]; then
  echo "CALL eval $*" >> "$LOG"
  CNT="$LOG.count"
  n=$(cat "$CNT" 2>/dev/null || echo 0)
  n=$((n + 1))
  echo "$n" > "$CNT"
  export STUB_CALL_NO="$n"
  json="" runs=1 cases=""
  if [ -n "${STUB_SNAPSHOT_DIR:-}" ]; then
    target=""
    for a in "$@"; do case "$a" in eval|plugin|-*) ;; *) target="$a"; break ;; esac; done
    # The positional target after "eval" is the plugin directory. Copy it before results are written.
    if [ -n "$target" ] && [ -d "$target" ]; then
      mkdir -p "$STUB_SNAPSHOT_DIR/call-$n" && cp -R "$target/." "$STUB_SNAPSHOT_DIR/call-$n/"
    fi
  fi
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json="$2"; shift ;;
      --runs) runs="$2"; shift ;;
      --case) cases="$2"; shift ;;  # real plugin eval keeps only the last --case
    esac
    shift
  done
  [ -n "$json" ] || { echo "claude stub: no --json" >&2; exit 99; }
  STUB_RUNS="$runs" STUB_CASES="$cases" STUB_JSON="$json" python3 -I - <<'PY'
import json, os, tempfile
n = os.environ["STUB_CALL_NO"]
runs = int(os.environ["STUB_RUNS"])
base = os.environ.get("STUB_TMP") or os.environ.get("TMPDIR") or "/tmp"
cases = []
for name in os.environ["STUB_CASES"].split():
    key = name.upper().replace("-", "_")
    default = 0 if name in ("setup-quick-question", "setup-non-coding") else runs
    k = int(os.environ.get("STUB_TRIG_%s_%s" % (n, key), default))
    out = []
    for i in range(runs):
        trig = i < k
        d = tempfile.mkdtemp(prefix="e-", dir=base)
        sealed = os.path.join(d, "sealed"); os.makedirs(os.path.join(sealed, "inner")); os.chmod(sealed, 0)  # real plugin eval leaves mode-000 dirs
        os.makedirs(os.path.join(d, "out"))
        tp = os.path.join(d, "out", "trace.jsonl")
        cmd = "graphify query x" if trig else "cat a.ts"
        lines = [{"type": "assistant", "message": {"model": "claude-stub-1", "content": [
            {"type": "tool_use", "name": "Bash", "input": {"command": cmd}}]}}]
        if name.startswith("read-order") and not trig:
            lines = [{"type": "assistant", "message": {"model": "claude-stub-1", "content": [
                {"type": "tool_use", "name": "Read", "input": {"file_path": "a.ts"}}]}}] + lines
        with open(tp, "w") as f:
            for l in lines:
                f.write(json.dumps(l) + "\n")
        os.chmod(d, 0o500)  # real plugin eval leaves the run dir itself read-only
        if name.startswith("read-order"):
            graders = [{"name": "bash-used", "passed": True, "explanation": "", "weight": 1, "withOnly": False, "scored": True}]
        else:
            passed = trig if name == "setup-planning" else (not trig)
            graders = [{"name": "triggered", "passed": passed, "explanation": "", "weight": 1, "withOnly": False, "scored": True}]
        if i < int(os.environ.get("STUB_ERR_%s_%s" % (n, key), 0)):
            graders = []
            err = os.environ.get("STUB_ERR_TEXT", "timeout")
        else:
            err = None
        out.append({"score": 1.0, "passed": True, "turns": 3, "costUsd": 0.05,
                    "error": err, "tracePath": tp, "graders": graders})
    cases.append({"name": name, "dir": "x", "arms": {"with": out}, "aggregates": {}})
res = {"schemaVersion": 1, "claudeVersion": "2.1.305", "startedAt": "2026-10-21T00:00:00Z",
       "durationSeconds": 1, "costUsd": 0.05 * runs * len(cases), "partial": os.environ.get("STUB_PARTIAL") == "1",
       "suite": {"ablation": "none", "modelOverride": None, "plugins": []},
       "cases": cases, "aggregates": {}}
with open(os.environ["STUB_JSON"], "w") as f:
    json.dump(res, f)
PY
  exit 1
fi
echo "claude stub: unexpected args: $*" >&2
exit 99
