#!/usr/bin/env bash
# PostToolUse prefilter for the setup-check nudge. It runs on every Bash and Skill call.
# It starts no Python and no git unless the payload can matter. No set -e: it must never block.
[ "${WARDEN_NUDGE_OFF:-}" = 1 ] && exit 0

payload=$(cat)

re='"session_id"[[:space:]]*:[[:space:]]*"([^"]*)"'
sid=""
if [[ "$payload" =~ $re ]]; then
  sid="${BASH_REMATCH[1]}"
fi
sid="${sid//[!A-Za-z0-9_-]/}"
[ -n "$sid" ] || exit 0

handoff=0
if [[ "$payload" != *'"agent_id"'* ]] && [ -e "$HOME/.claude/warden/nudge/${sid}.ready" ]; then
  handoff=1
else
  skill_re='"tool_name"[[:space:]]*:[[:space:]]*"Skill"'
  # Scan only what comes before "tool_response": command output must not start Python.
  # If that prefix has no "tool_input", the key order is unknown: scan the whole payload.
  scan="${payload%%\"tool_response\"*}"
  [[ "$scan" == *'"tool_input"'* ]] || scan="$payload"
  case "$scan" in
    # Create commands and graphify-setup always hand off.
    *'git init'*|*'git clone'*|*'create-next-app'*|*'npm create'*|\
    *'pnpm create'*|*'yarn create'*|*'bun create'*|*'npx create-'*|*'cargo new'*|*'cargo init'*|\
    *'uv init'*|*'graphify-setup'*) handoff=1 ;;
    # Commit, git -C and Skill calls hand off only when the session has a state file.
    *'git commit'*|*'git -C'*) [ -e "$HOME/.claude/warden/nudge/${sid}.json" ] && handoff=1 ;;
    *) [[ "$scan" =~ $skill_re ]] && [ -e "$HOME/.claude/warden/nudge/${sid}.json" ] && handoff=1 ;;
  esac
fi
[ "$handoff" = 1 ] || exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"
printf '%s' "$payload" | python3 -I "${ROOT}/scripts/warden-lesson" nudge
exit 0
