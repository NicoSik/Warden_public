#!/usr/bin/env bash
# Prints the Code Map rule as hook context. Usage: code-map SessionStart|SubagentStart
set -euo pipefail

event="${1:-}"
case "$event" in
  SessionStart|SubagentStart) ;;
  *) echo "code-map: unknown or missing event '${event}'" >&2; exit 2 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# The trailing x keeps the final newlines that $(...) would strip.
content=$(cat "${SCRIPT_DIR}/code-map.md" && printf x) || exit 1
content="${content%x}"

# Verbatim copy of escape_for_json in plugins/superpowers/hooks/session-start; apply a fix to both.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

if [ "$event" = SessionStart ]; then
  SETUP_DIR="$(cd -P "${SCRIPT_DIR}/../scripts" 2>/dev/null && pwd)" || exit 1
  SETUP="${SETUP_DIR}/graphify-setup"
  [ -f "$SETUP" ] && [ -x "$SETUP" ] || exit 1
  check=$(cat "${SCRIPT_DIR}/setup-check.md" && printf x) || exit 1
  check="${check%x}"
  placeholder='{{GRAPHIFY_SETUP}}'
  rest="${check//"$placeholder"/}"
  # Exactly one placeholder: removing it must shorten the text by its own length, once.
  [ $(( ${#check} - ${#rest} )) -eq ${#placeholder} ] || exit 1
  content="${content}${check//"$placeholder"/$SETUP}"
fi

printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$event" "$(escape_for_json "$content")"
