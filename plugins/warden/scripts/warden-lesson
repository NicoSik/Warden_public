#!/usr/bin/env python3
"""warden-lesson: a lesson inbox outside every repository.

Modes: hook, nudge, add, list, report, status, mark, weekly, schedule. This file holds the store, the secret scrub, retention and the hook.
"""
import datetime
import fcntl
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import time

sys.dont_write_bytecode = True

MAX_LINE = 512
RETENTION_DAYS = 30
# Keys whose values are identifiers (Claude Code pointers, git branch and commit). Only the long-run rule skips them; named secret shapes still apply.
RUN_RULE_EXEMPT_KEYS = frozenset({"session_id", "transcript_path", "tool_use_id", "h", "ts", "branch", "commit"})
CAPS = {"cmd": 40, "sig": 120, "text": 200}

# Every shape of hooks/guard-secrets.sh, then the extra shapes of REQ-7.1.
SECRET_PATTERNS = [
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)", re.S),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"),
    re.compile(r"bearer\s+[A-Za-z0-9._~+/-]{32,}", re.I),
    re.compile(r"gh[pousr]_[A-Za-z0-9]{20,}"),
    re.compile(r"sk-[A-Za-z0-9_-]{20,}"),
    re.compile(r"xox[abpr]-[A-Za-z0-9-]{10,}"),
    re.compile(r"Authorization:\s*\S+(?:\s+\S+)?"),
    re.compile(r"Bearer\s+\S+"),
    re.compile(r"(?:password|token|secret|api_key)=\S+", re.I),
]
LONG_RUN = re.compile(r"[A-Za-z0-9+/=_-]{40,}")


def inbox():
    root = os.environ.get("WARDEN_LESSON_ROOT") or os.path.join(
        os.path.expanduser("~"), ".claude", "lessons")
    return os.path.abspath(root)


def _nearest_existing(path):
    while not os.path.exists(path):
        parent = os.path.dirname(path)
        if parent == path:
            break
        path = parent
    return path


_GIT_TREE_CACHE = {}


def _inside_git_work_tree(path):
    d = _nearest_existing(path)
    if not os.path.isdir(d):
        d = os.path.dirname(d)
    if d not in _GIT_TREE_CACHE:
        _GIT_TREE_CACHE[d] = _probe_git_work_tree(d)
    return _GIT_TREE_CACHE[d]


def _probe_git_work_tree(d):
    """True when d or a parent holds a .git entry. This avoids a git process on the hook path."""
    d = os.path.abspath(d)
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return True
        parent = os.path.dirname(d)
        if parent == d:
            return False
        d = parent


def blocked_reasons():
    reasons = []
    if os.environ.get("WARDEN_LESSON_OFF") == "1":
        reasons.append("WARDEN_LESSON_OFF is 1")
    root = inbox()
    if _inside_git_work_tree(root):
        reasons.append("inside a git work tree")
    if not os.access(_nearest_existing(root), os.W_OK | os.X_OK):
        reasons.append("not writable")
    return reasons


def scrub(text, long_run=True):
    for pat in SECRET_PATTERNS:
        text = pat.sub("<secret>", text)
    if long_run:
        text = LONG_RUN.sub("<secret>", text)
    return text


def _encode(obj):
    return (json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")


def _fit(obj):
    """Scrub and cap every string value, then shorten the longest one until the line fits."""
    obj = {k: (scrub(v, k not in RUN_RULE_EXEMPT_KEYS) if isinstance(v, str) else v) for k, v in obj.items()}
    for k, n in CAPS.items():
        if isinstance(obj.get(k), str):
            obj[k] = obj[k][:n]
    data = _encode(obj)
    while len(data) > MAX_LINE:
        strs = [k for k, v in obj.items() if isinstance(v, str) and v]
        if not strs:
            return None
        k = max(strs, key=lambda x: len(obj[x]))
        over = len(data) - MAX_LINE
        obj[k] = obj[k][:max(0, len(obj[k]) - max(1, over // 3))]
        data = _encode(obj)
    return data


def _make_dirs(root, path):
    d = os.path.dirname(path)
    todo = []
    while d.startswith(root) and not os.path.isdir(d):
        todo.append(d)
        d = os.path.dirname(d)
    for p in reversed(todo):
        os.mkdir(p, 0o700)
        os.chmod(p, 0o700)


def write_line(path, obj):
    try:
        root = inbox()
        path = os.path.abspath(path)
        if not (path == root or path.startswith(root + os.sep)):
            return False
        if blocked_reasons():
            return False
        data = _fit(obj)
        if data is None:
            return False
        _make_dirs(root, path)
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.write(fd, data)
        finally:
            os.close(fd)
        return True
    except Exception:
        return False


def retention():
    """Delete session logs older than 30 days, at most once a day. Returns the count deleted."""
    try:
        if blocked_reasons():
            return 0
        root = inbox()
        sessions = os.path.join(root, "sessions")
        if not os.path.isdir(sessions):
            return 0
        marker = os.path.join(root, ".retention")
        today = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
        try:
            with open(marker) as f:
                if f.read().strip() == today:
                    return 0
        except OSError:
            pass
        cutoff = datetime.datetime.now().timestamp() - RETENTION_DAYS * 86400
        deleted = 0
        for name in os.listdir(sessions):
            p = os.path.join(sessions, name)
            if name.endswith(".jsonl") and os.path.isfile(p) and os.path.getmtime(p) < cutoff:
                try:
                    os.remove(p)
                    deleted += 1
                except OSError:
                    pass
        fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, (today + "\n").encode())
        finally:
            os.close(fd)
        return deleted
    except Exception:
        return 0


SKIP_EXIT = (0, 130, 143)
QUIET_STARTS = ("grep", "rg", "test", "[", "diff", "cmp", "pgrep", "command -v", "which")
PATH_RE = re.compile(r"(?:~|\.{1,2})?/[^\s:'\"]+|[A-Za-z]:\\\S+")
ASSIGN_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
TEST_RE = re.compile(
    r"^(?:pytest|py\.test|jest|vitest|mocha|rspec|tox"
    r"|python[0-9.]* -m (?:pytest|unittest)"
    r"|(?:npm|pnpm|yarn|bun|cargo|go|dotnet|mix|gradle|mvn)(?: run)? test(?::\S*)?"
    r"|make (?:test|check))(?:\s|$)")
SH_TEST_RE = re.compile(r"(?:^|/)tests?/[^\s]*\.sh$")
EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")

HEREDOC_RE = re.compile(r"(?<!<)<<(?!<)-?\s*(?:'([^']+)'|\"([^\"]+)\"|\\?([\w.-]+))")
PUNCTUATION = "();<>|&\n"
OPERATORS = ("&&", "||", "|", ";", "&")
OPENERS = ("do", "then", "else", "elif", "if", "while", "until", "!", "{")
CLOSERS = ("done", "fi", "esac", "}")
RUN_WRAPPERS = ("uv", "poetry", "pipenv", "pnpm", "hatch", "pdm", "rye")
PREFIX_WRAPPERS = ("npx", "bunx", "timeout", "time", "env", "nice", "command")
SHELLS = ("bash", "sh", "zsh")
# Commands whose output is file or repository content, and commands that print nothing of their own.
PASSIVE = frozenset({"cat", "head", "tail", "less", "more", "sed", "awk", "grep", "egrep", "fgrep", "rg", "ls", "find",
                     "tree", "wc", "sort", "uniq", "cut", "tr", "jq", "yq", "echo", "printf", "nl", "tee", "stat",
                     "file", "du", "df", "xxd", "od", "strings", "diff", "cd", "pwd", "export", "set", "true",
                     "false", "sleep"})
PASSIVE_GIT = ("log", "show", "diff", "status", "blame", "grep", "ls-files", "check-ignore")

ERROR_START = re.compile(r"(?:[\w.]*(?:Error|Exception)|error|ERROR|fatal|FATAL)(?:\[[^\]]*\])?:|E {3}|FAILED\b")
FAILED_SUMMARY = re.compile(r"\W*(?:Tests?:?\s+)?[1-9]\d* failed\b")
PASS_SUMMARY = re.compile(r"\b[1-9]\d* passed\b")
HIDDEN_FAILURE = re.compile(r"\b[1-9]\d* (?:failed|errors?)\b|^\s*FAILED\b|^\s*E {3}", re.M)


def _drop_heredocs(command):
    """Remove heredoc bodies. Their text is data, and it often holds unbalanced quotes."""
    lines = command.split("\n")
    out = []
    i = 0
    while i < len(lines):
        out.append(lines[i])
        delims = [a or b or c for a, b, c in HEREDOC_RE.findall(lines[i])]
        i += 1
        for delim in delims:
            end = next((j for j in range(i, len(lines)) if lines[j].strip() == delim), None)
            if end is not None:
                i = end + 1
    return "\n".join(out)


def _add_simple(chain, words, op):
    while words and (ASSIGN_RE.match(words[0]) or words[0] in OPENERS):
        words = words[1:]
    if words and words[0] not in CLOSERS:
        chain.append((words, op))


def parse_chain(command):
    """Split a command into a list of (words, operator after). Returns None when shlex cannot parse it."""
    text = _drop_heredocs(command or "").replace("\\\n", " ")
    text = "\n".join(ln for ln in text.split("\n") if not ln.lstrip().startswith("#"))
    try:
        lex = shlex.shlex(text, posix=True, punctuation_chars=PUNCTUATION)
        lex.whitespace = " \t\r"
        lex.whitespace_split = True
        lex.commenters = ""
        tokens = list(lex)
    except ValueError:
        return None
    chain, words, skip_target = [], [], False
    for raw in tokens:
        if not raw or set(raw) - set(PUNCTUATION):
            if skip_target:
                skip_target = False
            else:
                words.append(raw)
            continue
        tok = raw.replace("\n", "").replace("(", "").replace(")", "").replace("|&", "|").replace(";;", ";")
        if tok and tok not in OPERATORS and set(tok) & set("<>"):
            if words and words[-1].isdigit():
                words.pop()
            skip_target = True
            continue
        skip_target = False
        _add_simple(chain, words, tok if tok in OPERATORS else ";")
        words = []
    _add_simple(chain, words, "")
    return chain


def _base(word):
    return os.path.basename(word) or word


def _unwrap(words):
    """Drop runners such as `uv run` and `timeout 60` in front of the real command."""
    while len(words) > 1:
        first = _base(words[0])
        if first in RUN_WRAPPERS and words[1] in ("run", "exec"):
            words = words[2:]
        elif first in PREFIX_WRAPPERS:
            words = words[1:]
        else:
            break
        while len(words) > 1 and (not words[0] or words[0][0] == "-" or words[0][0].isdigit()
                                  or ASSIGN_RE.match(words[0])):
            words = words[1:]
    return [_base(words[0])] + words[1:] if words else words


def _runs_tests(words):
    real = _unwrap(words)
    if not real:
        return False
    if TEST_RE.match(" ".join(real)) or SH_TEST_RE.search(words[0]):
        return True
    if real[0] in SHELLS:
        script = next((w for w in real[1:] if not w.startswith("-")), "")
        return bool(SH_TEST_RE.search(script)) and "-c" not in real[1:]
    return False


def _test_index(chain):
    """Return the index of the last simple command that runs tests, or None."""
    for i in range(len(chain or []) - 1, -1, -1):
        if _runs_tests(chain[i][0]):
            return i
    return None


def last_simple(command):
    chain = parse_chain(command)
    return " ".join(chain[-1][0]) if chain else ""


def is_test_like(command):
    return _test_index(parse_chain(command)) is not None


def test_hash(command, cwd):
    """Hash the test words and the folder they run in. Returns None for a command that runs no test."""
    chain = parse_chain(command)
    i = _test_index(chain)
    if i is None:
        return None
    for words, _ in chain[:i]:
        if words[0] == "cd" and len(words) > 1:
            cwd = os.path.normpath(os.path.join(cwd, os.path.expanduser(words[1])))
    return hashlib.sha256((" ".join(_unwrap(chain[i][0])) + "\0" + cwd).encode()).hexdigest()[:16]


def test_passed(command, tool_response):
    """True when a successful Bash call proves that its test passed.

    The exit status belongs to the last command of a chain. A test that a pipe or `;` follows can fail while
    the call exits 0. In that case only a pass summary with no failure summary counts.
    """
    chain = parse_chain(command)
    i = _test_index(chain)
    if i is None:
        return False
    pipefail = any(w[0] == "set" and "pipefail" in w for w, _ in chain)
    if all(op == "&&" or (pipefail and op == "|") for _, op in chain[i:-1]):
        return True
    resp = tool_response if isinstance(tool_response, dict) else {}
    out = "%s\n%s" % (resp.get("stdout") or "", resp.get("stderr") or "")
    return bool(PASS_SUMMARY.search(out)) and not HIDDEN_FAILURE.search(out)


def cmd_name(command):
    chain = parse_chain(command)
    if chain is None:
        return "unparsed"
    if not chain:
        return ""
    i = _test_index(chain)
    words = _unwrap(chain[i][0]) if i is not None else chain[-1][0]
    name = _base(words[0])
    if len(words) > 1 and re.fullmatch(r"[a-z][a-z-]*", words[1]):
        name += " " + words[1]
    return name[:CAPS["cmd"]]


def _is_passive(words):
    first = _base(words[0])
    return first in PASSIVE or (first == "git" and len(words) > 1 and words[1] in PASSIVE_GIT)


def _runs_inline_script(words):
    real = _unwrap(words)
    return real[0].startswith(("python", "node", "ruby", "perl")) and any(w in ("-", "-c", "-e") for w in real[1:])


def _output_source(chain):
    """Return the words of the command that produced the end of the output: the head of the last pipeline."""
    i = len(chain) - 1
    while i > 0 and chain[i - 1][1] == "|":
        i -= 1
    return chain[i][0]


def _traceback_end(raw, i):
    return next((ln for ln in raw[i + 1:] if ln.strip() and not ln[0].isspace()), None)


def _pick_error_line(raw, names, strict, has_test):
    """Return the first line that starts like an error. A strict search accepts only `<name>:` lines."""
    prefix = re.compile(r"(?:\(eval\)|%s)(?::|\s+line\b)" % "|".join(re.escape(n) for n in sorted(names)))
    for i, ln in enumerate(raw):
        line = ln.strip()
        if line.startswith("node:internal/"):  # A Node stack frame, not the error.
            continue
        if prefix.match(line):
            return line
        if strict:
            continue
        if line.startswith("Traceback (most recent call last)") and _traceback_end(raw, i):
            return _traceback_end(raw, i).strip()
        if ERROR_START.match(line) or (has_test and FAILED_SUMMARY.match(line)):
            return line
    return None


def signature(error, command=""):
    """Pick the line that names the failure. File content must never qualify.

    A command that only shows files gets its own `<name>:` lines and nothing else. The last-line fallback
    applies only when the end of the output came from a command that is not a file viewer or an inline script.
    """
    raw = (error or "").split("\n")[1:]
    chain = parse_chain(command)
    names = set(SHELLS)
    names.update(_base(w[0]) for w, _ in chain or [])
    if any(_base(w[0]) == "git" for w, _ in chain or []):
        names.update(("fatal", "error"))
    strict = chain is None or all(_is_passive(w) for w, _ in chain)
    line = _pick_error_line(raw, names, strict, _test_index(chain) is not None)
    source = _output_source(chain) if chain else None
    if line is None and source and not _is_passive(source) and not _runs_inline_script(source):
        line = next((ln.strip() for ln in reversed(raw)
                     if ln.strip() and not ln.strip().startswith("node:internal/")), None)
    if not line:
        return ""
    return scrub(PATH_RE.sub("<path>", line))[:CAPS["sig"]]


def _git_info(cwd):
    """Run the three rev-parse calls in parallel. Each has a 2-second timeout and gives "" on error."""
    argsets = [("--show-toplevel",), ("--abbrev-ref", "HEAD"), ("--short", "HEAD")]
    procs = []
    for a in argsets:
        try:
            procs.append(subprocess.Popen(["git", "-C", cwd, "rev-parse", *a],
                                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True))
        except Exception:
            procs.append(None)
    out = []
    for pr in procs:
        try:
            o, _ = pr.communicate(timeout=2)
            out.append(o.strip() if pr.returncode == 0 else "")
        except Exception:
            try:
                pr.kill()
            except Exception:
                pass
            out.append("")
    return out


def _now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _skip_exit1(command):
    last = last_simple(command)
    if last.startswith("git diff") and "--quiet" in last.split():
        return True
    return any(last == w or last.startswith(w + " ") for w in QUIET_STARTS)


def _hook(args):
    try:
        if os.environ.get("WARDEN_LESSON_OFF") == "1":
            return 0
        p = json.loads(sys.stdin.read())
        if not isinstance(p, dict):
            return 0
        tool = p.get("tool_name")
        event = p.get("hook_event_name")
        sid = re.sub(r"[^A-Za-z0-9_-]", "", str(p.get("session_id") or "")) or "unknown"
        path = os.path.join(inbox(), "sessions", sid + ".jsonl")
        cwd = p.get("cwd") or ""
        command = (p.get("tool_input") or {}).get("command") or ""
        if event == "PostToolUseFailure":
            if tool != "Bash" or p.get("is_interrupt"):
                return 0
            error = p.get("error") or ""
            m = re.match(r"Exit code (\d+)", error)
            if not m:
                return 0
            code = int(m.group(1))
            if code in SKIP_EXIT or (code == 1 and _skip_exit1(command)):
                return 0
            top, branch, commit = _git_info(cwd)
            obj = {
                "t": "fail", "ts": _now(), "src": "hook", "cmd": cmd_name(command),
                "exit": code, "sig": signature(error, command), "session_id": p.get("session_id") or "",
                "transcript_path": p.get("transcript_path") or "",
                "tool_use_id": p.get("tool_use_id") or "",
                "repo": os.path.basename(top) if top else "",
                "branch": branch, "commit": commit,
            }
            h = test_hash(command, cwd)
            if h:
                obj["h"] = h
            write_line(path, obj)
        elif event == "PostToolUse":
            if tool == "Bash":
                if test_passed(command, p.get("tool_response")):
                    write_line(path, {"t": "pass", "ts": _now(),
                                      "tool_use_id": p.get("tool_use_id") or "", "h": test_hash(command, cwd)})
            elif tool in EDIT_TOOLS:
                write_line(path, {"t": "edit", "ts": _now()})
        retention()
    except BaseException:
        pass
    return 0


NUDGE_DAYS = 7
NUDGE_BUDGET = 4.0
NUDGE_STATUS_TIMEOUT = 3.0
NUDGE_SKILLS = frozenset({"brainstorming", "writing-specs", "writing-plans", "systematic-debugging"})
NUDGE_CREATE = (("npm", "create"), ("pnpm", "create"), ("yarn", "create"), ("bun", "create"),
                ("cargo", "new"), ("cargo", "init"), ("uv", "init"))


def _nudge_dir():
    return os.path.join(os.path.expanduser("~"), ".claude", "warden", "nudge")


def _git_parts(words):
    """For a git command, return (subcommand, path given to -C). Returns (None, None) for anything else."""
    words = _unwrap(words)
    if not words or _base(words[0]) != "git":
        return None, None
    path, i = None, 1
    while i < len(words):
        w = words[i]
        if w == "-C" and i + 1 < len(words):
            path = words[i + 1]
            i += 2
        elif w == "-c" and i + 1 < len(words):
            i += 2
        elif w.startswith("-"):
            i += 1
        else:
            return w, path
    return None, path


def _resolve(path, base):
    path = os.path.expanduser(path)
    return os.path.normpath(path if os.path.isabs(path) else os.path.join(base, path))


def _call_folder(chain, cwd):
    """The folder a command runs in: a leading cd, else the first git -C, else cwd."""
    if chain:
        words, op = chain[0]
        if words[0] == "cd" and len(words) >= 2 and op == "&&":
            return _resolve(words[1], cwd)
        for words, _ in chain:
            _sub, path = _git_parts(words)
            if path:
                return _resolve(path, cwd)
    return cwd


def _repo_info(folder):
    """Return (id, toplevel) for the repository that holds folder, or None."""
    try:
        if not folder or not os.path.isdir(folder):
            return None
        r = subprocess.run(["git", "-C", folder, "rev-parse", "--path-format=absolute", "--git-common-dir",
                            "--show-toplevel"], capture_output=True, text=True, timeout=1,
                           stdin=subprocess.DEVNULL)
        lines = r.stdout.splitlines()
        if r.returncode != 0 or len(lines) < 2:
            return None
        common = os.path.realpath(lines[0])
        top = os.path.realpath(lines[1])
        name = os.path.basename(common)
        if name == ".git":
            name = os.path.basename(os.path.dirname(common))
        return name + "#" + hashlib.sha256(common.encode()).hexdigest()[:8], top
    except Exception:
        return None


def _birth(path):
    try:
        return os.stat(path).st_birthtime
    except Exception:
        return None


def _is_create(words):
    words = _unwrap(words)
    sub, _ = _git_parts(words)
    if sub in ("init", "clone"):
        return True
    if not words:
        return False
    name = _base(words[0])
    if name.startswith("create-") and name != "create-":
        return True
    if len(words) >= 2 and (name, words[1]) in NUDGE_CREATE:
        return True
    if name == "npx":
        rest = [w for w in words[1:] if not w.startswith("-")]
        return bool(rest) and rest[0].startswith("create-")
    return False


def _runs_setup(words):
    if not words:
        return False
    if _base(words[0]) == "graphify-setup":
        return True
    return words[0] in SHELLS and len(words) > 1 and _base(words[1]) == "graphify-setup"


def _skill_triggers(tool_input):
    name = tool_input.get("skill")
    if not isinstance(name, str) or not name:
        return True
    return name.rsplit(":", 1)[-1] in NUDGE_SKILLS


def _load_template(root):
    try:
        with open(os.path.join(root, "hooks", "setup-nudge.md"), encoding="utf-8") as f:
            text = f.read()
    except Exception:
        return None
    if text.count("{{REPO}}") != 1 or text.count("{{GRAPHIFY_SETUP}}") != 1:
        return None
    return text


def _render(template, variant, top, setup):
    lines = []
    for ln in template.split("\n"):
        m = re.match(r"(skill|commit): ", ln)
        if m:
            if m.group(1) != variant:
                continue
            ln = ln[m.end():]
        lines.append(ln)
    vals = {"{{REPO}}": shlex.quote(top), "{{GRAPHIFY_SETUP}}": shlex.quote(setup)}
    return re.sub(r"\{\{REPO\}\}|\{\{GRAPHIFY_SETUP\}\}", lambda m: vals[m.group(0)], "\n".join(lines)).strip("\n")


def _status_word(setup, top, timeout):
    proc = None
    try:
        proc = subprocess.Popen([setup, "status"], cwd=top, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                stdin=subprocess.DEVNULL, text=True, start_new_session=True)
        out, _ = proc.communicate(timeout=timeout)
        return out.strip()
    except BaseException:
        if proc is not None:
            try:
                os.killpg(proc.pid, 9)
            except Exception:
                pass
            try:
                proc.communicate(timeout=1)
            except Exception:
                pass
        return None


def _read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            v = json.load(f)
        return v if isinstance(v, type(default)) else default
    except Exception:
        return default


def _write_state(d, sid, state):
    tmp = os.path.join(d, "%s.json.tmp%d" % (sid, os.getpid()))
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f)
    os.replace(tmp, os.path.join(d, sid + ".json"))
    cutoff = time.time() - NUDGE_DAYS * 86400
    for name in os.listdir(d):
        if name == sid + ".lock":
            continue
        try:
            fp = os.path.join(d, name)
            if not (os.path.isfile(fp) and os.stat(fp).st_mtime < cutoff):
                continue
            if name.endswith(".lock"):
                js = os.path.join(d, name[:-5] + ".json")
                if os.path.exists(js) and os.stat(js).st_mtime >= cutoff:
                    continue
            os.remove(fp)
        except OSError:
            pass


def _nudge(args):
    out = ""
    try:
        out = _nudge_run()
    except BaseException:
        out = ""
    try:
        if out:
            sys.stdout.write(out)
            sys.stdout.flush()
    except BaseException:
        pass
    return 0


def _nudge_run():
    deadline = time.monotonic() + NUDGE_BUDGET
    p = json.loads(sys.stdin.read())
    if not isinstance(p, dict):
        return ""
    sid = re.sub(r"[^A-Za-z0-9_-]", "", str(p.get("session_id") or ""))
    if not sid:
        return ""
    sub = "agent_id" in p
    tool = p.get("tool_name")
    tool_input = p.get("tool_input") if isinstance(p.get("tool_input"), dict) else {}
    cwd = p.get("cwd") if isinstance(p.get("cwd"), str) and p.get("cwd") else os.getcwd()
    command = tool_input.get("command") if tool == "Bash" else ""
    command = command if isinstance(command, str) else ""
    chain = (parse_chain(command) if command else []) or []
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    setup = os.path.join(root, "scripts", "graphify-setup")
    log = os.path.join(inbox(), "sessions", sid + ".jsonl")
    folder = _call_folder(chain, cwd)

    if any(_runs_setup(w) for w, _ in chain):
        info = _repo_info(folder) if deadline - time.monotonic() >= 1 else None
        if info:
            write_line(log, {"t": "setup-call", "ts": _now(), "repo": info[0]})

    creates = any(_is_create(w) for w, _ in chain)
    commit_dirs = []
    for w, _ in chain:
        s, path = _git_parts(w)
        if s == "commit":
            commit_dirs.append(_resolve(path, cwd) if path else folder)
    skill = (not sub) and tool == "Skill" and _skill_triggers(tool_input)
    d = _nudge_dir()
    has_marker = (not sub) and os.path.exists(os.path.join(d, sid + ".ready"))
    if not (creates or commit_dirs or skill or has_marker):
        return ""
    if not (creates or has_marker or os.path.exists(os.path.join(d, sid + ".json"))):
        return ""
    template = None if sub else _load_template(root)

    os.makedirs(d, mode=0o700, exist_ok=True)
    os.chmod(d, 0o700)
    with open(os.path.join(d, sid + ".lock"), "a") as lockf:
        while True:
            try:
                fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    return ""
                time.sleep(0.05)
        state0 = _read_json(os.path.join(d, sid + ".json"), {})
        pending = state0.get("pending") if isinstance(state0.get("pending"), dict) else {}
        nudged = state0.get("nudged") if isinstance(state0.get("nudged"), list) else []
        dropped = state0.get("dropped") if isinstance(state0.get("dropped"), list) else []
        before = {"pending": dict(pending), "nudged": list(nudged), "dropped": list(dropped)}
        ready_path = os.path.join(d, sid + ".ready")
        queued = _read_json(ready_path, {})

        if creates:
            start = _birth(p.get("transcript_path")) if isinstance(p.get("transcript_path"), str) else None
            if start is not None:
                cands = [folder]
                try:
                    cands += [os.path.join(folder, n) for n in sorted(os.listdir(folder))
                              if os.path.exists(os.path.join(folder, n, ".git"))]
                except OSError:
                    pass
                found = []
                for c in cands:
                    if deadline - time.monotonic() < 1:
                        found = [(None, None)]
                        break
                    info = _repo_info(c)
                    if info:
                        found.append((info, _birth(os.path.join(info[1], ".git"))))
                if all(b is not None for _, b in found):
                    for info, born in found:
                        if info[0] not in nudged and info[0] not in dropped and born > start:
                            pending[info[0]] = info[1]

        checks, trigger_of = [], {}
        for c in commit_dirs:
            if deadline - time.monotonic() < 1:
                break
            info = _repo_info(c)
            if info and info[0] in pending and info[0] not in checks:
                checks.append(info[0])
                trigger_of[info[0]] = "commit"
        if skill:
            for i in pending:
                trigger_of[i] = "skill"
                if i not in checks:
                    checks.append(i)
        due = {}
        for i in checks:
            if i in queued or i not in pending:
                continue
            left = deadline - time.monotonic()
            if left <= 0:
                break
            word = _status_word(setup, pending[i], min(NUDGE_STATUS_TIMEOUT, left))
            if word in ("ready", "declined"):
                pending.pop(i, None)
                dropped.append(i)
            elif word in ("ask", "build", "no-cli"):
                due[i] = word

        items = []
        if sub:
            if due:
                queued.update(due)
                fd = os.open(ready_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as f:
                    json.dump(queued, f)
        elif template is not None:
            for i, word in due.items():
                items.append((i, word, trigger_of.get(i, "commit"), "direct"))
            claimed = os.path.join(d, "%s.claimed.%d" % (sid, os.getpid()))
            try:
                os.rename(ready_path, claimed)
            except OSError:
                claimed = None
            if claimed:
                for i, word in _read_json(claimed, {}).items():
                    if i in pending and i not in due:
                        items.append((i, str(word), "commit", "marker"))
                try:
                    os.remove(claimed)
                except OSError:
                    pass

        out = ""
        if items:
            blocks = [_render(template, t, pending[i], setup) for i, _, t, _ in items]
            out = json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse",
                                                     "additionalContext": "\n\n".join(blocks)}})
            for i, word, t, via in items:
                write_line(log, {"t": "nudge", "ts": _now(), "repo": i, "trigger": t, "via": via, "word": word})
                pending.pop(i, None)
                nudged.append(i)
        state = {"pending": pending, "nudged": nudged, "dropped": dropped}
        if state != before:
            _write_state(d, sid, state)
        return out


def _add(args):
    text = " ".join(args.text).strip()
    if not text:
        print('usage: warden-lesson add "<text>" [--by agent]', file=sys.stderr)
        return 2
    top, branch, commit = _git_info(os.getcwd())
    obj = {"t": "lesson", "ts": _now(), "src": "agent" if args.by == "agent" else "user",
           "text": text, "repo": os.path.basename(top) if top else "",
           "branch": branch, "commit": commit}
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if sid:
        obj["session_id"] = sid
    if not write_line(os.path.join(inbox(), "manual.jsonl"), obj):
        print("warden-lesson: capture is disabled; run warden-lesson status", file=sys.stderr)
        return 1
    return 0


def _read_lines(path):
    out = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for ln in f:
                try:
                    d = json.loads(ln)
                except ValueError:
                    continue
                if isinstance(d, dict):
                    out.append(d)
    except OSError:
        pass
    return out


def _log_files():
    root = inbox()
    files = []
    sessions = os.path.join(root, "sessions")
    try:
        files = [os.path.join(sessions, n) for n in sorted(os.listdir(sessions)) if n.endswith(".jsonl")]
    except OSError:
        pass
    return files, os.path.join(root, "manual.jsonl")


def _norm(sig):
    """Return the signature with every digit run replaced by N. Both groupings use it."""
    return re.sub(r"\d+", "N", str(sig or ""))


def _session_records(lines):
    groups = {}
    for i, d in enumerate(lines):
        if d.get("t") != "fail":
            continue
        key = (d.get("cmd"), d.get("exit"), _norm(d.get("sig")))
        g = groups.get(key)
        if g is None:
            g = groups[key] = {"first": d, "count": 0, "last_i": i, "h": d.get("h")}
        g["count"] += 1
        g["last_i"] = i
        g["h"] = g["h"] or d.get("h")
    recs = []
    for g in groups.values():
        d = g["first"]
        rec = {"t": "fail", "ts": lines[g["last_i"]].get("ts") or d.get("ts") or "", "src": d.get("src") or "hook",
               "repo": d.get("repo") or "", "branch": d.get("branch") or "", "commit": d.get("commit") or "",
               "cmd": d.get("cmd") or "", "exit": d.get("exit"), "sig": d.get("sig") or "",
               "count": g["count"], "fixed": False}
        if g["h"]:
            for j in range(g["last_i"] + 1, len(lines)):
                if lines[j].get("t") == "pass" and lines[j].get("h") == g["h"]:
                    rec["fixed"] = True
                    rec["fixed_by"] = lines[j].get("tool_use_id") or ""
                    rec["edits"] = sum(1 for x in lines[g["last_i"] + 1:j] if x.get("t") == "edit")
                    break
        recs.append(rec)
    return recs


def _all_records():
    files, manual = _log_files()
    recs = []
    for f in files:
        recs.extend(_session_records(_read_lines(f)))
    for d in _read_lines(manual):
        if d.get("t") == "lesson":
            recs.append({"t": "lesson", "ts": d.get("ts") or "", "src": d.get("src") or "user",
                         "repo": d.get("repo") or "", "branch": d.get("branch") or "",
                         "commit": d.get("commit") or "", "text": d.get("text") or "", "count": 1,
                         "session_id": d.get("session_id") or ""})
    recs.sort(key=lambda r: r["ts"], reverse=True)
    return recs


HIDE_REASONS = ("fixed test failure", "one-off exception", "no signature", "ignored")
EXCEPTION_RE = re.compile(r"(?:[\w.]+\.)?(\w+(?:Error|Exception)):")
ENV_EXCEPTIONS = frozenset({"ModuleNotFoundError", "ImportError", "FileNotFoundError", "PermissionError",
                            "ConnectionRefusedError", "TimeoutError", "OSError"})


def _hide_reason(g):
    """Return why a report group is hidden, or None. Only `no signature` hides a group seen in 2+ sessions."""
    if not g["sig"]:
        return "no signature"
    if g["flagged"] or len(g["sessions"]) != 1:
        return None
    if all(r["fixed"] and r.get("edits", 0) > 0 for r in g["recs"]):
        return "fixed test failure"
    m = EXCEPTION_RE.match(g["sig"])
    if m and m.group(1) not in ENV_EXCEPTIONS:
        return "one-off exception"
    return None


def report_rows(include_hidden=False):
    """Group the failures of every session by normalized signature. Read-only.

    Return (rows, lessons, hidden_counts). hidden_counts does not depend on include_hidden.
    """
    files, manual = _log_files()
    groups = {}
    for f in files:
        session = os.path.basename(f)[:-len(".jsonl")]
        for r in _session_records(_read_lines(f)):
            g = groups.setdefault(_norm(r["sig"]), {"sig": r["sig"], "recs": [], "sessions": set()})
            g["recs"].append(r)
            g["sessions"].add(session)
    rows, hidden_counts = [], {}
    for norm, g in groups.items():
        repos = sorted({r["repo"] for r in g["recs"] if r["repo"]})
        g["flagged"] = len(repos) >= 2 or len(g["sessions"]) >= 3
        reason = _hide_reason(g)
        if reason:
            hidden_counts[reason] = hidden_counts.get(reason, 0) + 1
            if not include_hidden:
                continue
        rows.append({"sig": g["sig"], "norm": norm, "sessions": len(g["sessions"]), "repos": repos,
                     "session_names": sorted(g["sessions"]),
                     "count": sum(r["count"] for r in g["recs"]),
                     "cmds": sorted({r["cmd"] for r in g["recs"] if r["cmd"]}),
                     "last_ts": max(r["ts"] for r in g["recs"]), "flagged": g["flagged"],
                     "flaky": any(r["fixed"] and r.get("edits", 0) == 0 for r in g["recs"]),
                     "hidden": reason})
    rows.sort(key=lambda r: r["last_ts"], reverse=True)
    rows.sort(key=lambda r: (not r["flagged"], -r["sessions"]))
    lessons = [d for d in _all_records() if d["t"] == "lesson"]
    return rows, lessons, hidden_counts


def nudge_rows():
    """List every setup-check nudge, newest first. Read-only.

    A nudge is followed when its session log holds a setup-call for the same repo with a later ts.
    """
    files, _ = _log_files()
    rows = []
    for f in files:
        session = os.path.basename(f)[:-len(".jsonl")]
        lines = _read_lines(f)
        calls = [(d.get("repo"), str(d.get("ts") or "")) for d in lines if d.get("t") == "setup-call"]
        for d in lines:
            if d.get("t") != "nudge":
                continue
            ts = str(d.get("ts") or "")
            rows.append({"ts": ts, "repo": d.get("repo") or "", "trigger": d.get("trigger") or "",
                         "via": d.get("via") or "", "word": d.get("word") or "", "session": session,
                         "followed": any(r == d.get("repo") and t > ts for r, t in calls)})
    rows.sort(key=lambda r: r["ts"], reverse=True)
    return rows


def row_line(r):
    parts = ["!!" if r["flagged"] else "--", "s%d" % r["sessions"], "x%d" % r["count"],
             ",".join(r["repos"]) or "-", ",".join(r["cmds"]) or "-", r["sig"] or "-"]
    if r["flaky"]:
        parts.append("flaky")
    if r.get("ledger_tag"):
        parts.append("ledger(%s)" % r["ledger_tag"])
    if r["hidden"]:
        parts.append("hidden(%s)" % r["hidden"])
    return "  ".join(parts)


def nudge_line(n):
    return "  ".join([n["ts"][:10], n["repo"] or "-", n["trigger"] or "-", n["via"] or "-",
                      n["word"] or "-", "setup-call" if n["followed"] else "no setup-call"])


def format_report(rows, lessons, nudges, hidden):
    """Return the report lines, without the ledger section."""
    out = [row_line(r) for r in rows]
    if lessons:
        out.append("\nLessons:")
        for d in lessons:
            out.append("  ".join([d["ts"][:10], d["src"], d["repo"] or "-", d["text"]]))
    if nudges:
        out.append("\nNudges:")
        out.extend(nudge_line(n) for n in nudges)
    if rows or lessons or nudges:
        out.append("")
    shown = ["%d %s" % (hidden[k], k) for k in HIDE_REASONS if hidden.get(k)]
    out.append("hidden: " + (", ".join(shown) if shown else "0"))
    return out


def _report(args):
    try:
        has_ledger = os.path.getsize(os.path.join(inbox(), "ledger.jsonl")) > 0
    except OSError:
        has_ledger = False
    if has_ledger:
        led = _ledger()
        print(led.render_report(led.ledger_view(args.all)))
        return 0
    rows, lessons, hidden = report_rows(include_hidden=args.all)
    for line in format_report(rows, lessons, nudge_rows(), hidden):
        print(line)
    return 0


def _list(args):
    recs = _all_records()
    for r in recs:
        if args.json:
            print(json.dumps(r, ensure_ascii=False))
            continue
        what = r["text"] if r["t"] == "lesson" else r["sig"]
        fixed = "-"
        if r.get("fixed"):
            fixed = "fixed(%s, %d edits)" % (r.get("fixed_by", ""), r.get("edits", 0))
        print("  ".join([r["ts"][:10], r["src"], r["repo"] or "-", r.get("cmd") or "-",
                         what or "-", "x%d" % r["count"], fixed]))
    return 0


def _status(args):
    reasons = blocked_reasons()
    recs = _all_records()
    count = len(recs)
    last = max((r["ts"] for r in recs), default="")
    print("inbox: " + inbox())
    print("capture: enabled" if not reasons else "capture: disabled (%s)" % ", ".join(reasons))
    print("records: %d" % count)
    print("last write: " + (last or "never"))
    return 0


def _ledger():
    """Load warden_ledger.py by path on first use. The hook path never calls this."""
    mod = sys.modules.get("warden_ledger")
    if mod is None:
        import importlib.util
        path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "warden_ledger.py")
        spec = importlib.util.spec_from_file_location("warden_ledger", path)
        mod = importlib.util.module_from_spec(spec)
        sys.modules["warden_ledger"] = mod
        spec.loader.exec_module(mod)
    mod.WL = sys.modules[__name__]
    return mod


def main(argv=None):
    import argparse  # Lazy: the hook path does not need it.
    parser = argparse.ArgumentParser(prog="warden-lesson")
    sub = parser.add_subparsers(dest="mode", required=True)
    pa = sub.add_parser("add")
    pa.add_argument("text", nargs="*")
    pa.add_argument("--by", default="user")
    pa.set_defaults(func=_add)
    pl = sub.add_parser("list")
    pl.add_argument("--json", action="store_true")
    pl.set_defaults(func=_list)
    pr = sub.add_parser("report")
    pr.add_argument("--all", action="store_true")
    pr.set_defaults(func=_report)
    sub.add_parser("status").set_defaults(func=_status)
    pm = sub.add_parser("mark")
    pm.add_argument("slug", nargs="?")
    pm.add_argument("status", nargs="?")
    pm.add_argument("--match")
    pm.add_argument("--nudge", action="store_true")
    pm.add_argument("--pr", type=int)
    pm.add_argument("--fixed-on", dest="fixed_on")
    pm.add_argument("--note")
    pm.add_argument("--history", action="store_true")
    pm.add_argument("--list", action="store_true")
    pm.set_defaults(func=lambda a: _ledger().mark_cmd(a))
    sub.add_parser("hook").set_defaults(func=_hook)
    sub.add_parser("nudge").set_defaults(func=_nudge)
    args, _ = parser.parse_known_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
