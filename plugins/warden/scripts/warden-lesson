#!/usr/bin/env python3
"""warden-lesson: a lesson inbox outside every repository.

Modes: hook, add, list, status. This file holds the store, the secret scrub, retention and the hook.
"""
import datetime
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys

sys.dont_write_bytecode = True

MAX_LINE = 512
RETENTION_DAYS = 30
# Keys whose values are identifiers (Claude Code pointers, git branch and commit). Only the long-run rule skips them; named secret shapes still apply.
RUN_RULE_EXEMPT_KEYS = frozenset({"session_id", "transcript_path", "tool_use_id", "h", "ts", "branch", "commit"})
CAPS = {"cmd": 40, "sig": 120, "text": 200}

# Every shape of hooks/guard-secrets.sh, then the extra shapes of REQ-7.1.
SECRET_PATTERNS = [
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)", re.S),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"),
    re.compile(r"bearer\s+[A-Za-z0-9._~+/-]{32,}", re.I),
    re.compile(r"gh[pousr]_[A-Za-z0-9]{20,}"),
    re.compile(r"sk-[A-Za-z0-9_-]{20,}"),
    re.compile(r"xox[abpr]-[A-Za-z0-9-]{10,}"),
    re.compile(r"Authorization:\s*\S+(?:\s+\S+)?"),
    re.compile(r"Bearer\s+\S+"),
    re.compile(r"(?:password|token|secret|api_key)=\S+", re.I),
]
LONG_RUN = re.compile(r"[A-Za-z0-9+/=_-]{40,}")


def inbox():
    root = os.environ.get("WARDEN_LESSON_ROOT") or os.path.join(
        os.path.expanduser("~"), ".claude", "lessons")
    return os.path.abspath(root)


def _nearest_existing(path):
    while not os.path.exists(path):
        parent = os.path.dirname(path)
        if parent == path:
            break
        path = parent
    return path


_GIT_TREE_CACHE = {}


def _inside_git_work_tree(path):
    d = _nearest_existing(path)
    if not os.path.isdir(d):
        d = os.path.dirname(d)
    if d not in _GIT_TREE_CACHE:
        _GIT_TREE_CACHE[d] = _probe_git_work_tree(d)
    return _GIT_TREE_CACHE[d]


def _probe_git_work_tree(d):
    """True when d or a parent holds a .git entry. This avoids a git process on the hook path."""
    d = os.path.abspath(d)
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return True
        parent = os.path.dirname(d)
        if parent == d:
            return False
        d = parent


def blocked_reasons():
    reasons = []
    if os.environ.get("WARDEN_LESSON_OFF") == "1":
        reasons.append("WARDEN_LESSON_OFF is 1")
    root = inbox()
    if _inside_git_work_tree(root):
        reasons.append("inside a git work tree")
    if not os.access(_nearest_existing(root), os.W_OK | os.X_OK):
        reasons.append("not writable")
    return reasons


def scrub(text, long_run=True):
    for pat in SECRET_PATTERNS:
        text = pat.sub("<secret>", text)
    if long_run:
        text = LONG_RUN.sub("<secret>", text)
    return text


def _encode(obj):
    return (json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")


def _fit(obj):
    """Scrub and cap every string value, then shorten the longest one until the line fits."""
    obj = {k: (scrub(v, k not in RUN_RULE_EXEMPT_KEYS) if isinstance(v, str) else v) for k, v in obj.items()}
    for k, n in CAPS.items():
        if isinstance(obj.get(k), str):
            obj[k] = obj[k][:n]
    data = _encode(obj)
    while len(data) > MAX_LINE:
        strs = [k for k, v in obj.items() if isinstance(v, str) and v]
        if not strs:
            return None
        k = max(strs, key=lambda x: len(obj[x]))
        over = len(data) - MAX_LINE
        obj[k] = obj[k][:max(0, len(obj[k]) - max(1, over // 3))]
        data = _encode(obj)
    return data


def _make_dirs(root, path):
    d = os.path.dirname(path)
    todo = []
    while d.startswith(root) and not os.path.isdir(d):
        todo.append(d)
        d = os.path.dirname(d)
    for p in reversed(todo):
        os.mkdir(p, 0o700)
        os.chmod(p, 0o700)


def write_line(path, obj):
    try:
        root = inbox()
        path = os.path.abspath(path)
        if not (path == root or path.startswith(root + os.sep)):
            return False
        if blocked_reasons():
            return False
        data = _fit(obj)
        if data is None:
            return False
        _make_dirs(root, path)
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.write(fd, data)
        finally:
            os.close(fd)
        return True
    except Exception:
        return False


def retention():
    """Delete session logs older than 30 days, at most once a day. Returns the count deleted."""
    try:
        if blocked_reasons():
            return 0
        root = inbox()
        sessions = os.path.join(root, "sessions")
        if not os.path.isdir(sessions):
            return 0
        marker = os.path.join(root, ".retention")
        today = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
        try:
            with open(marker) as f:
                if f.read().strip() == today:
                    return 0
        except OSError:
            pass
        cutoff = datetime.datetime.now().timestamp() - RETENTION_DAYS * 86400
        deleted = 0
        for name in os.listdir(sessions):
            p = os.path.join(sessions, name)
            if name.endswith(".jsonl") and os.path.isfile(p) and os.path.getmtime(p) < cutoff:
                try:
                    os.remove(p)
                    deleted += 1
                except OSError:
                    pass
        fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, (today + "\n").encode())
        finally:
            os.close(fd)
        return deleted
    except Exception:
        return 0


SKIP_EXIT = (0, 130, 143)
QUIET_STARTS = ("grep", "rg", "test", "[", "diff", "cmp", "pgrep", "command -v", "which")
PATH_RE = re.compile(r"(?:~|\.{1,2})?/[^\s:'\"]+|[A-Za-z]:\\\S+")
ASSIGN_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
TEST_RE = re.compile(
    r"^(?:pytest|py\.test|jest|vitest|mocha|rspec|tox"
    r"|python[0-9.]* -m (?:pytest|unittest)"
    r"|(?:npm|pnpm|yarn|bun|cargo|go|dotnet|mix|gradle|mvn)(?: run)? test(?::\S*)?"
    r"|make (?:test|check))(?:\s|$)")
SH_TEST_RE = re.compile(r"(?:^|/)tests?/[^\s]*\.sh$")
EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")

HEREDOC_RE = re.compile(r"(?<!<)<<(?!<)-?\s*(?:'([^']+)'|\"([^\"]+)\"|\\?([\w.-]+))")
PUNCTUATION = "();<>|&\n"
OPERATORS = ("&&", "||", "|", ";", "&")
OPENERS = ("do", "then", "else", "elif", "if", "while", "until", "!", "{")
CLOSERS = ("done", "fi", "esac", "}")
RUN_WRAPPERS = ("uv", "poetry", "pipenv", "pnpm", "hatch", "pdm", "rye")
PREFIX_WRAPPERS = ("npx", "bunx", "timeout", "time", "env", "nice", "command")
SHELLS = ("bash", "sh", "zsh")
# Commands whose output is file or repository content, and commands that print nothing of their own.
PASSIVE = frozenset({"cat", "head", "tail", "less", "more", "sed", "awk", "grep", "egrep", "fgrep", "rg", "ls", "find",
                     "tree", "wc", "sort", "uniq", "cut", "tr", "jq", "yq", "echo", "printf", "nl", "tee", "stat",
                     "file", "du", "df", "xxd", "od", "strings", "diff", "cd", "pwd", "export", "set", "true",
                     "false", "sleep"})
PASSIVE_GIT = ("log", "show", "diff", "status", "blame", "grep", "ls-files", "check-ignore")

ERROR_START = re.compile(r"(?:[\w.]*(?:Error|Exception)|error|ERROR|fatal|FATAL)(?:\[[^\]]*\])?:|E {3}|FAILED\b")
FAILED_SUMMARY = re.compile(r"\W*(?:Tests?:?\s+)?[1-9]\d* failed\b")
PASS_SUMMARY = re.compile(r"\b[1-9]\d* passed\b")
HIDDEN_FAILURE = re.compile(r"\b[1-9]\d* (?:failed|errors?)\b|^\s*FAILED\b|^\s*E {3}", re.M)


def _drop_heredocs(command):
    """Remove heredoc bodies. Their text is data, and it often holds unbalanced quotes."""
    lines = command.split("\n")
    out = []
    i = 0
    while i < len(lines):
        out.append(lines[i])
        delims = [a or b or c for a, b, c in HEREDOC_RE.findall(lines[i])]
        i += 1
        for delim in delims:
            end = next((j for j in range(i, len(lines)) if lines[j].strip() == delim), None)
            if end is not None:
                i = end + 1
    return "\n".join(out)


def _add_simple(chain, words, op):
    while words and (ASSIGN_RE.match(words[0]) or words[0] in OPENERS):
        words = words[1:]
    if words and words[0] not in CLOSERS:
        chain.append((words, op))


def parse_chain(command):
    """Split a command into a list of (words, operator after). Returns None when shlex cannot parse it."""
    text = _drop_heredocs(command or "").replace("\\\n", " ")
    text = "\n".join(ln for ln in text.split("\n") if not ln.lstrip().startswith("#"))
    try:
        lex = shlex.shlex(text, posix=True, punctuation_chars=PUNCTUATION)
        lex.whitespace = " \t\r"
        lex.whitespace_split = True
        lex.commenters = ""
        tokens = list(lex)
    except ValueError:
        return None
    chain, words, skip_target = [], [], False
    for raw in tokens:
        if not raw or set(raw) - set(PUNCTUATION):
            if skip_target:
                skip_target = False
            else:
                words.append(raw)
            continue
        tok = raw.replace("\n", "").replace("(", "").replace(")", "").replace("|&", "|").replace(";;", ";")
        if tok and tok not in OPERATORS and set(tok) & set("<>"):
            if words and words[-1].isdigit():
                words.pop()
            skip_target = True
            continue
        skip_target = False
        _add_simple(chain, words, tok if tok in OPERATORS else ";")
        words = []
    _add_simple(chain, words, "")
    return chain


def _base(word):
    return os.path.basename(word) or word


def _unwrap(words):
    """Drop runners such as `uv run` and `timeout 60` in front of the real command."""
    while len(words) > 1:
        first = _base(words[0])
        if first in RUN_WRAPPERS and words[1] in ("run", "exec"):
            words = words[2:]
        elif first in PREFIX_WRAPPERS:
            words = words[1:]
        else:
            break
        while len(words) > 1 and (not words[0] or words[0][0] == "-" or words[0][0].isdigit()
                                  or ASSIGN_RE.match(words[0])):
            words = words[1:]
    return [_base(words[0])] + words[1:] if words else words


def _runs_tests(words):
    real = _unwrap(words)
    if not real:
        return False
    if TEST_RE.match(" ".join(real)) or SH_TEST_RE.search(words[0]):
        return True
    if real[0] in SHELLS:
        script = next((w for w in real[1:] if not w.startswith("-")), "")
        return bool(SH_TEST_RE.search(script)) and "-c" not in real[1:]
    return False


def _test_index(chain):
    """Return the index of the last simple command that runs tests, or None."""
    for i in range(len(chain or []) - 1, -1, -1):
        if _runs_tests(chain[i][0]):
            return i
    return None


def last_simple(command):
    chain = parse_chain(command)
    return " ".join(chain[-1][0]) if chain else ""


def is_test_like(command):
    return _test_index(parse_chain(command)) is not None


def test_hash(command, cwd):
    """Hash the test words and the folder they run in. Returns None for a command that runs no test."""
    chain = parse_chain(command)
    i = _test_index(chain)
    if i is None:
        return None
    for words, _ in chain[:i]:
        if words[0] == "cd" and len(words) > 1:
            cwd = os.path.normpath(os.path.join(cwd, os.path.expanduser(words[1])))
    return hashlib.sha256((" ".join(_unwrap(chain[i][0])) + "\0" + cwd).encode()).hexdigest()[:16]


def test_passed(command, tool_response):
    """True when a successful Bash call proves that its test passed.

    The exit status belongs to the last command of a chain. A test that a pipe or `;` follows can fail while
    the call exits 0. In that case only a pass summary with no failure summary counts.
    """
    chain = parse_chain(command)
    i = _test_index(chain)
    if i is None:
        return False
    pipefail = any(w[0] == "set" and "pipefail" in w for w, _ in chain)
    if all(op == "&&" or (pipefail and op == "|") for _, op in chain[i:-1]):
        return True
    resp = tool_response if isinstance(tool_response, dict) else {}
    out = "%s\n%s" % (resp.get("stdout") or "", resp.get("stderr") or "")
    return bool(PASS_SUMMARY.search(out)) and not HIDDEN_FAILURE.search(out)


def cmd_name(command):
    chain = parse_chain(command)
    if chain is None:
        return "unparsed"
    if not chain:
        return ""
    i = _test_index(chain)
    words = _unwrap(chain[i][0]) if i is not None else chain[-1][0]
    name = _base(words[0])
    if len(words) > 1 and re.fullmatch(r"[a-z][a-z-]*", words[1]):
        name += " " + words[1]
    return name[:CAPS["cmd"]]


def _is_passive(words):
    first = _base(words[0])
    return first in PASSIVE or (first == "git" and len(words) > 1 and words[1] in PASSIVE_GIT)


def _runs_inline_script(words):
    real = _unwrap(words)
    return real[0].startswith(("python", "node", "ruby", "perl")) and any(w in ("-", "-c", "-e") for w in real[1:])


def _output_source(chain):
    """Return the words of the command that produced the end of the output: the head of the last pipeline."""
    i = len(chain) - 1
    while i > 0 and chain[i - 1][1] == "|":
        i -= 1
    return chain[i][0]


def _traceback_end(raw, i):
    return next((ln for ln in raw[i + 1:] if ln.strip() and not ln[0].isspace()), None)


def _pick_error_line(raw, names, strict, has_test):
    """Return the first line that starts like an error. A strict search accepts only `<name>:` lines."""
    prefix = re.compile(r"(?:\(eval\)|%s)(?::|\s+line\b)" % "|".join(re.escape(n) for n in sorted(names)))
    for i, ln in enumerate(raw):
        line = ln.strip()
        if prefix.match(line):
            return line
        if strict:
            continue
        if line.startswith("Traceback (most recent call last)") and _traceback_end(raw, i):
            return _traceback_end(raw, i).strip()
        if ERROR_START.match(line) or (has_test and FAILED_SUMMARY.match(line)):
            return line
    return None


def signature(error, command=""):
    """Pick the line that names the failure. File content must never qualify.

    A command that only shows files gets its own `<name>:` lines and nothing else. The last-line fallback
    applies only when the end of the output came from a command that is not a file viewer or an inline script.
    """
    raw = (error or "").split("\n")[1:]
    chain = parse_chain(command)
    names = set(SHELLS)
    names.update(_base(w[0]) for w, _ in chain or [])
    if any(_base(w[0]) == "git" for w, _ in chain or []):
        names.update(("fatal", "error"))
    strict = chain is None or all(_is_passive(w) for w, _ in chain)
    line = _pick_error_line(raw, names, strict, _test_index(chain) is not None)
    source = _output_source(chain) if chain else None
    if line is None and source and not _is_passive(source) and not _runs_inline_script(source):
        line = next((ln.strip() for ln in reversed(raw) if ln.strip()), None)
    if not line:
        return ""
    return scrub(PATH_RE.sub("<path>", line))[:CAPS["sig"]]


def _git_info(cwd):
    """Run the three rev-parse calls in parallel. Each has a 2-second timeout and gives "" on error."""
    argsets = [("--show-toplevel",), ("--abbrev-ref", "HEAD"), ("--short", "HEAD")]
    procs = []
    for a in argsets:
        try:
            procs.append(subprocess.Popen(["git", "-C", cwd, "rev-parse", *a],
                                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True))
        except Exception:
            procs.append(None)
    out = []
    for pr in procs:
        try:
            o, _ = pr.communicate(timeout=2)
            out.append(o.strip() if pr.returncode == 0 else "")
        except Exception:
            try:
                pr.kill()
            except Exception:
                pass
            out.append("")
    return out


def _now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _skip_exit1(command):
    last = last_simple(command)
    if last.startswith("git diff") and "--quiet" in last.split():
        return True
    return any(last == w or last.startswith(w + " ") for w in QUIET_STARTS)


def _hook(args):
    try:
        if os.environ.get("WARDEN_LESSON_OFF") == "1":
            return 0
        p = json.loads(sys.stdin.read())
        if not isinstance(p, dict):
            return 0
        tool = p.get("tool_name")
        event = p.get("hook_event_name")
        sid = re.sub(r"[^A-Za-z0-9_-]", "", str(p.get("session_id") or "")) or "unknown"
        path = os.path.join(inbox(), "sessions", sid + ".jsonl")
        cwd = p.get("cwd") or ""
        command = (p.get("tool_input") or {}).get("command") or ""
        if event == "PostToolUseFailure":
            if tool != "Bash" or p.get("is_interrupt"):
                return 0
            error = p.get("error") or ""
            m = re.match(r"Exit code (\d+)", error)
            if not m:
                return 0
            code = int(m.group(1))
            if code in SKIP_EXIT or (code == 1 and _skip_exit1(command)):
                return 0
            top, branch, commit = _git_info(cwd)
            obj = {
                "t": "fail", "ts": _now(), "src": "hook", "cmd": cmd_name(command),
                "exit": code, "sig": signature(error, command), "session_id": p.get("session_id") or "",
                "transcript_path": p.get("transcript_path") or "",
                "tool_use_id": p.get("tool_use_id") or "",
                "repo": os.path.basename(top) if top else "",
                "branch": branch, "commit": commit,
            }
            h = test_hash(command, cwd)
            if h:
                obj["h"] = h
            write_line(path, obj)
        elif event == "PostToolUse":
            if tool == "Bash":
                if test_passed(command, p.get("tool_response")):
                    write_line(path, {"t": "pass", "ts": _now(),
                                      "tool_use_id": p.get("tool_use_id") or "", "h": test_hash(command, cwd)})
            elif tool in EDIT_TOOLS:
                write_line(path, {"t": "edit", "ts": _now()})
        retention()
    except BaseException:
        pass
    return 0


def _add(args):
    text = " ".join(args.text).strip()
    if not text:
        print('usage: warden-lesson add "<text>" [--by agent]', file=sys.stderr)
        return 2
    top, branch, commit = _git_info(os.getcwd())
    obj = {"t": "lesson", "ts": _now(), "src": "agent" if args.by == "agent" else "user",
           "text": text, "repo": os.path.basename(top) if top else "",
           "branch": branch, "commit": commit}
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if sid:
        obj["session_id"] = sid
    if not write_line(os.path.join(inbox(), "manual.jsonl"), obj):
        print("warden-lesson: capture is disabled; run warden-lesson status", file=sys.stderr)
        return 1
    return 0


def _read_lines(path):
    out = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for ln in f:
                try:
                    d = json.loads(ln)
                except ValueError:
                    continue
                if isinstance(d, dict):
                    out.append(d)
    except OSError:
        pass
    return out


def _log_files():
    root = inbox()
    files = []
    sessions = os.path.join(root, "sessions")
    try:
        files = [os.path.join(sessions, n) for n in sorted(os.listdir(sessions)) if n.endswith(".jsonl")]
    except OSError:
        pass
    return files, os.path.join(root, "manual.jsonl")


def _session_records(lines):
    groups = {}
    for i, d in enumerate(lines):
        if d.get("t") != "fail":
            continue
        key = (d.get("cmd"), d.get("exit"), re.sub(r"\d+", "N", str(d.get("sig") or "")))
        g = groups.get(key)
        if g is None:
            g = groups[key] = {"first": d, "count": 0, "last_i": i, "h": d.get("h")}
        g["count"] += 1
        g["last_i"] = i
        g["h"] = g["h"] or d.get("h")
    recs = []
    for g in groups.values():
        d = g["first"]
        rec = {"t": "fail", "ts": lines[g["last_i"]].get("ts") or d.get("ts") or "", "src": d.get("src") or "hook",
               "repo": d.get("repo") or "", "branch": d.get("branch") or "", "commit": d.get("commit") or "",
               "cmd": d.get("cmd") or "", "exit": d.get("exit"), "sig": d.get("sig") or "",
               "count": g["count"], "fixed": False}
        if g["h"]:
            for j in range(g["last_i"] + 1, len(lines)):
                if lines[j].get("t") == "pass" and lines[j].get("h") == g["h"]:
                    rec["fixed"] = True
                    rec["fixed_by"] = lines[j].get("tool_use_id") or ""
                    rec["edits"] = sum(1 for x in lines[g["last_i"] + 1:j] if x.get("t") == "edit")
                    break
        recs.append(rec)
    return recs


def _all_records():
    files, manual = _log_files()
    recs = []
    for f in files:
        recs.extend(_session_records(_read_lines(f)))
    for d in _read_lines(manual):
        if d.get("t") == "lesson":
            recs.append({"t": "lesson", "ts": d.get("ts") or "", "src": d.get("src") or "user",
                         "repo": d.get("repo") or "", "branch": d.get("branch") or "",
                         "commit": d.get("commit") or "", "text": d.get("text") or "", "count": 1,
                         "session_id": d.get("session_id") or ""})
    recs.sort(key=lambda r: r["ts"], reverse=True)
    return recs


def _list(args):
    recs = _all_records()
    for r in recs:
        if args.json:
            print(json.dumps(r, ensure_ascii=False))
            continue
        what = r["text"] if r["t"] == "lesson" else r["sig"]
        fixed = "-"
        if r.get("fixed"):
            fixed = "fixed(%s, %d edits)" % (r.get("fixed_by", ""), r.get("edits", 0))
        print("  ".join([r["ts"][:10], r["src"], r["repo"] or "-", r.get("cmd") or "-",
                         what or "-", "x%d" % r["count"], fixed]))
    return 0


def _status(args):
    reasons = blocked_reasons()
    recs = _all_records()
    count = len(recs)
    last = max((r["ts"] for r in recs), default="")
    print("inbox: " + inbox())
    print("capture: enabled" if not reasons else "capture: disabled (%s)" % ", ".join(reasons))
    print("records: %d" % count)
    print("last write: " + (last or "never"))
    return 0


def main(argv=None):
    import argparse  # Lazy: the hook path does not need it.
    parser = argparse.ArgumentParser(prog="warden-lesson")
    sub = parser.add_subparsers(dest="mode", required=True)
    pa = sub.add_parser("add")
    pa.add_argument("text", nargs="*")
    pa.add_argument("--by", default="user")
    pa.set_defaults(func=_add)
    pl = sub.add_parser("list")
    pl.add_argument("--json", action="store_true")
    pl.set_defaults(func=_list)
    sub.add_parser("status").set_defaults(func=_status)
    sub.add_parser("hook").set_defaults(func=_hook)
    args, _ = parser.parse_known_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
